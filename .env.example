# Google Gemini API Key (필수사항)
# AI 기능 사용을 위해 반드시 설정해야 합니다
# https://aistudio.google.com/app/apikey 에서 API 키 발급
GEMINI_API_KEY=your-api-key-here

# Gamma API Key (선택사항)
# Gamma Pro 계정 필요
# Settings → API key 탭에서 API 키 생성
# 형식: sk-gamma-xxxxxxxx
GAMMA_API_KEY=your-gamma-api-key-here

# Server Port (기본값: 3000)
PORT=3000
